# DVDrone Web Range — Environment Configuration
# Copy to .env (gitignored) and fill in your values.

PORT=4000
HOST=0.0.0.0

# Local dev: dvd.localhost
# Tailscale beta: <your-tailscale-ip>.nip.io  (or run scripts/start-tailscale.sh)
# Production: sim.yourdomain.com
BASE_HOST=dvd.localhost

# Runtime driver: docker-lite (macOS/Linux Lite) or linux-vm (Linux host w/ mac80211_hwsim Wi-Fi)
RUNTIME_DRIVER=docker-lite
MAX_SLOTS=5
IDLE_MINUTES=45
HARD_CAP_HOURS=2

# Optional fixed invite code for first admin registration on a fresh DB
# ADMIN_INVITE=beta-admin-1

# Grounded Tactical AI Copilot (Track C — DeepSeek / OpenAI-compatible)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL_FAST=deepseek-chat
AI_MODEL_PRO=deepseek-reasoner
AI_DAILY_REQ_LIMIT=40
AI_MAX_TOKENS=1100
